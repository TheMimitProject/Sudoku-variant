{
  "name": "sudoku-variant",
  "version": "0.3.0",
  "description": "Sudoku variants and other text games for the bitchat Bluetooth mesh — browser simulators plus a host CLI for real play",
  "type": "module",
  "bin": {
    "meshhost": "bin/meshhost.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "words": "node scripts/build-words.mjs",
    "host": "node bin/meshhost.js",
    "relay": "node scripts/local-relay.mjs"
  },
  "keywords": [
    "bitchat",
    "bluetooth",
    "mesh",
    "sudoku",
    "offline",
    "p2p",
    "games"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TheMimitProject/Sudoku-variant"
  },
  "homepage": "https://themimitproject.github.io/Sudoku-variant/",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "leaflet": "^1.9.4",
    "nostr-tools": "^2.25.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "an-array-of-english-words": "^2.0.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
